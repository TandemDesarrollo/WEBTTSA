# Puerto del host donde se publica el sitio (mapea al 8080 del contenedor)
PORT=8080

# Dokploy Compose: las variables se inyectan explícitamente en mail-api.
# No hay proveedor ni remitente confirmados; completar antes de habilitar envíos.
SMTP_HOST=
MAIL_FROM=
# Cifrado obligatorio: starttls o ssl (TLS directo).
SMTP_SECURITY=starttls
# Vacío elige 587 con starttls o 465 con ssl; el proveedor puede requerir otro puerto.
SMTP_PORT=
# Segundos por operación de red, de 1 a 60; no es un plazo total del envío.
SMTP_TIMEOUT=15
# Configurar ambos si requiere login; no se implementa OAuth.
SMTP_USERNAME=
SMTP_PASSWORD=
# Buzón que ya figura en la página; cambiar solo con confirmación del responsable.
CONTACT_TO=info@tandemtech.com.ar
